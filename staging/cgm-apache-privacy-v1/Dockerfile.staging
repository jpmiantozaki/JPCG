# STAGING-ONLY alternative: preserve original public/ APK-facing routes unchanged.
FROM php:8.3-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && docker-php-ext-install pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html
COPY public/ /var/www/html/
COPY staging/cgm-apache-privacy-v1/apache/000-default.conf /etc/apache2/sites-available/000-default.conf
RUN apache2ctl -t
EXPOSE 80
