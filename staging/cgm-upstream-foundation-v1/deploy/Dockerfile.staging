# Staging container ONLY. No real provider is wired; original /session.php returns 503.
FROM php:8.3-apache
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev \
    && docker-php-ext-install pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/cgm-upstream
COPY src/ ./src/
COPY public/ ./public/
COPY deploy/apache-path-only.conf /etc/apache2/sites-available/000-default.conf
EXPOSE 80
